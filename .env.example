# Optional TURN relay for online play between players behind restrictive NATs.
# Get credentials from any TURN provider (e.g. metered.ca, Twilio, Cloudflare) and set these
# in Vercel's environment variables. Without them, direct connections via STUN are used.
# VITE_TURN_URLS=turn:your.turn.host:443,turns:your.turn.host:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
